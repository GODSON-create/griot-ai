# ============================================================================
# GRIOT AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy to .env and populate real credentials. Never commit .env to version control.
# ============================================================================

# Server & Environment
GRIOT_ENV=development
PORT=4100
GRIOT_PORT=4100
GRIOT_HOST=127.0.0.1

# Explicit CORS Allowed Origins (comma-separated; never use '*' in production)
GRIOT_ALLOWED_ORIGINS=https://lovable.dev,https://*.lovable.app,https://*.lovableproject.com,http://localhost:3000,http://localhost:5173,http://localhost:4100,http://127.0.0.1:4100

# Storage & Database
# Local development & tests (when GRIOT_DATABASE_URL is empty): SQLite database file
GRIOT_SQLITE_PATH=./data/griot.db
# Production PostgreSQL / Supabase connection URI (pooled/transaction or direct SSL URI):
GRIOT_DATABASE_URL=
# Private storage vault root directory (never exposed via public URLs)
GRIOT_PRIVATE_STORAGE_DIR=./storage/private
# Set to true when GRIOT_PRIVATE_STORAGE_DIR is backed by a persistent disk / durable volume
GRIOT_STORAGE_DURABLE=true

# Security & Cryptography (Required in production: set explicitly in host/Render env vars)
GRIOT_JWT_SECRET=
GRIOT_VAULT_MASTER_KEY=
GRIOT_FILE_SIGNING_SECRET=

# Model Registry Configuration Path
GRIOT_MODEL_REGISTRY_PATH=./config/models.registry.json

# Model Provider API Credentials (Never hardcoded; loaded at runtime or via Org Vault)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Local or Compatible Open-Weight Inference Endpoint (e.g., Ollama on 127.0.0.1:11434)
OPEN_WEIGHT_API_KEY=
OPEN_WEIGHT_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Cost, Concurrency & Rate Limit Controls
GRIOT_ALLOW_MOCK_PROVIDERS=false
GRIOT_DEFAULT_RATE_LIMIT_RPM=120
GRIOT_MAX_REQUEST_BYTES=10485760
GRIOT_ENABLE_RESPONSE_CACHE=true
GRIOT_CACHE_TTL_SECONDS=3600
GRIOT_REQUEST_TIMEOUT_MS=30000
GRIOT_MAX_RETRIES_PER_PROVIDER=1
GRIOT_LOCAL_MAX_CONCURRENT=1
GRIOT_LOCAL_MAX_QUEUED=4
GRIOT_LOCAL_QUEUE_TIMEOUT_MS=20000
