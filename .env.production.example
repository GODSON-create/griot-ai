# ============================================================================
# GRIOT AI — PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# Variable names only — populate values in Render Dashboard or host environment.
# NEVER commit real secrets to version control.
# ============================================================================

GRIOT_ENV=production
NODE_ENV=production
# Render automatically injects PORT at runtime (e.g. 10000); GRIOT_PORT is used as fallback
# PORT=10000
GRIOT_PORT=4100
GRIOT_HOST=0.0.0.0

# Explicit Allowed Browser Origins (comma-separated, no wildcard '*')
GRIOT_ALLOWED_ORIGINS=https://lovable.dev,https://*.lovable.app,https://*.lovableproject.com

# Persistent Database (Supabase PostgreSQL SSL connection URI) or Local Persistent SQLite
GRIOT_DATABASE_URL=
GRIOT_SQLITE_PATH=./data/griot.db

# Private File Storage Directory & Durability Indicator
GRIOT_PRIVATE_STORAGE_DIR=./storage/private
GRIOT_STORAGE_DURABLE=false

# Mandatory Cryptographic Secrets (Must be set by operator before production startup)
GRIOT_JWT_SECRET=
GRIOT_VAULT_MASTER_KEY=
GRIOT_FILE_SIGNING_SECRET=

# Production Provider Execution Controls (Strict live execution, no mock fallback)
GRIOT_ALLOW_MOCK_PROVIDERS=false
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OPEN_WEIGHT_API_KEY=
OPEN_WEIGHT_BASE_URL=
